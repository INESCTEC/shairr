FROM node:22.12-alpine

# Set working directory
WORKDIR /app

# Install Angular CLI globally
RUN npm install -g @angular/cli

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm install

# Copy application source
COPY . .

# Expose port 4200
EXPOSE 4200

# Run the dev server with hot reload
CMD ["npm", "run", "start"]